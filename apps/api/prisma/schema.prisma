generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id                 String @id @default("default")
  seoTitle           String
  seoDescription     String
  seoMenuTitle       String
  seoMenuDescription String
  seoImage           String
  navCtaLabel        String
  navCtaUrl          String
  heroEyebrow        String
  heroTitle          String
  heroIntro          String
  heroPrimaryLabel   String
  heroPrimaryUrl     String
  heroSecondaryLabel String
  heroSecondaryUrl   String
  heroTags           String[]
  footerTitle        String
  footerIntro        String
  footerEmail        String
  footerInstagramUrl String
  footerTiktokUrl    String
  footerCopyright    String
  videosEyebrow      String
  videosTitle        String
  videosIntro        String
  seoPages           Json     @default("{}")
  vacancyRoles       Json     @default("{}")
  openingHours       Json     @default("{}")
  ourStory           Json     @default("{}")
  reviews            Json     @default("{}")
  instagramFeed      Json     @default("{}")
  promoPopup         Json     @default("{}")
  mailRelay          Json     @default("{}")
  contactForm        Json     @default("{}")
  cateringCatalog    Json     @default("{}")
  navigation         Json     @default("{}")
  seoSiteUrl           String   @default("https://tresamigos.nl")
  seoGoogleVerification String  @default("")
  seoBingVerification   String  @default("")
  ourValue             Json     @default("{}")
  pageMedia            Json     @default("{}")
  updatedAt          DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  permissions  String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PromoLead {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String   @default("")
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([subscribedAt])
}

model IntegrationSettings {
  id                     String    @id @default("primary")
  mailRelayEnabled       Boolean   @default(false)
  mailRelayProvider      String    @default("smtp")
  mailRelayHost          String    @default("")
  mailRelayPort          Int       @default(587)
  mailRelaySecure        Boolean   @default(false)
  mailRelayUsername      String    @default("")
  mailRelayPassword      String    @default("")
  mailRelayFromEmail     String    @default("")
  mailRelayFromName      String    @default("Tres Amigos")
  mailRelayLastTestAt    DateTime?
  mailRelayLastStatus    String    @default("")
  mailRelayLastMessage   String    @default("")
  mailRelayGoogleRefreshToken String @default("")
  mailRelayGoogleAccessToken  String @default("")
  mailRelayGoogleTokenExpiry  DateTime?
  mailRelayGoogleEmail        String @default("")
  mailNotifyApplications String    @default("work@tresamigos.nl")
  mailNotifyCatering     String    @default("catering@tresamigos.nl")
  mailNotifyFranchise    String    @default("Vilmon@tresamigos.nl")
  mailNotifyOther        String    @default("no-reply@tresamigos.nl")
  googleAdsEnabled       Boolean   @default(true)
  googleAdsConversionId  String    @default("AW-16851426878")
  newsletterEnabled      Boolean   @default(true)
  newsletterShowFooter   Boolean   @default(true)
  newsletterShowHome     Boolean   @default(true)
  newsletterShowPages    Boolean   @default(true)
  updatedAt              DateTime  @updatedAt
}

model Location {
  id            String         @id
  area          String
  name          String
  address       String
  note          String
  code          String         @unique
  featured      Boolean        @default(false)
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  links         OrderLink[]
  countStaff    CountStaff[]
  countSessions CountSession[]
  franchiseAccounts FranchiseAccount[]
  franchisePrices   FranchiseProductPrice[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model OrderLink {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  label      String
  url        String
  sortOrder  Int      @default(0)
}

model Video {
  id        String   @id
  title     String
  caption   String
  src       String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuCategory {
  id         String     @id
  title      String
  orderLabel String
  active     Boolean    @default(true)
  sortOrder  Int        @default(0)
  items      MenuItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model MenuItem {
  id          String       @id
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String
  price       String
  image       String       @default("")
  featured    Boolean      @default(false)
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
}

model ReviewSubmission {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  status      String   @default("pending")
  author      String
  email       String   @default("")
  rating      Int      @default(5)
  text        String
  publishedAt String   @default("")
}

model Application {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  status           String   @default("nieuw")
  role             String
  name             String
  email            String
  phone            String   @default("")
  days             String[]
  availabilityNote String   @default("")
  experience       String   @default("")
  motivation       String   @default("")
  pdfName          String?
  pdfSize          Int?
  pdfData          String?  @db.Text
}

model FranchiseInquiry {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  status          String   @default("nieuw")
  name            String
  email           String
  phone           String   @default("")
  address         String   @default("")
  desiredLocation String   @default("")
  currentRole     String   @default("")
  company         String   @default("")
  investment      String   @default("")
  financing       String   @default("")
  visitedLocation String   @default("")
  termsAccepted   Boolean  @default(false)
}

model CateringOrder {
  id           String   @id @default(uuid())
  orderNumber  String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  status       String   @default("nieuw")
  boxId        String
  quantity     Int
  proteins     String[]
  toppings     String[]
  salsas       String[]
  diet         String[]
  notes        String   @default("")
  fulfillment  String
  locationId   String   @default("")
  locationName String   @default("")
  address      String   @default("")
  eventDate    String
  eventTime    String
  name         String
  email        String
  phone        String   @default("")
  company      String   @default("")
  vatId        String   @default("")
  adminNotes   String   @default("")
  items        Json     @default("[]")
  subtotalCents Int     @default(0)
}

model CountList {
  id         String             @id
  title      String
  active     Boolean            @default(true)
  sortOrder  Int                @default(0)
  products   CountListProduct[]
  sessions   CountSession[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model CountCategory {
  id        String         @id
  name      String
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  products  CountProduct[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model CountProduct {
  id         String             @id
  categoryId String
  category   CountCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  active     Boolean            @default(true)
  sortOrder  Int                @default(0)
  lines      CountLine[]
  lists      CountListProduct[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([categoryId, sortOrder])
}

model CountListProduct {
  listId    String
  productId String
  sortOrder Int          @default(0)
  list      CountList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  product   CountProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([listId, productId])
  @@index([listId, sortOrder])
}

model CountStaff {
  id          String         @id @default(uuid())
  name        String
  loginLookup String         @unique
  loginHash   String
  loginHint   String
  active      Boolean        @default(true)
  locationId  String?
  location    Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sessions    CountSession[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model CountSession {
  id           String      @id @default(uuid())
  locationId   String
  location     Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  locationName String
  locationCode String      @default("")
  listId       String
  list         CountList   @relation(fields: [listId], references: [id], onDelete: Restrict)
  listTitle    String
  staffId      String?
  staff        CountStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffName    String
  shift        String
  status       String      @default("draft")
  countDate    String
  submittedAt  DateTime?
  lines        CountLine[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([locationId, countDate, shift, listId])
  @@index([countDate, shift])
  @@index([staffId])
  @@index([listId])
}

model CountLine {
  id           String       @id @default(uuid())
  sessionId    String
  session      CountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId    String?
  product      CountProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  categoryName String
  quantity     Decimal?     @db.Decimal(10, 2)
  note         String       @default("")
  sortOrder    Int          @default(0)

  @@index([sessionId, sortOrder])
}

model FranchiseAccount {
  id           String               @id @default(uuid())
  email        String               @unique
  name         String
  passwordHash String
  locationId   String
  location     Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  orders       FranchiseShopOrder[]

  @@index([locationId])
}

model FranchiseShopProduct {
  id          String                  @id @default(uuid())
  name        String
  description String                  @default("")
  image       String                  @default("")
  sku         String                  @default("")
  active      Boolean                 @default(true)
  sortOrder   Int                     @default(0)
  prices      FranchiseProductPrice[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model FranchiseProductPrice {
  id         String               @id @default(uuid())
  productId  String
  product    FranchiseShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  priceCents Int
  updatedAt  DateTime             @updatedAt

  @@unique([productId, locationId])
  @@index([locationId])
}

model FranchiseShopOrder {
  id             String                   @id @default(uuid())
  orderNumber    String                   @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  status         String                   @default("nieuw")
  accountId      String
  account        FranchiseAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  locationId     String
  locationName   String
  locationCode   String                   @default("")
  notes          String                   @default("")
  adminNotes     String                   @default("")
  subtotalCents  Int                      @default(0)
  invoiceNumber  String                   @default("")
  items          FranchiseShopOrderItem[]

  @@index([accountId])
  @@index([locationId])
  @@index([createdAt])
}

model FranchiseShopOrderItem {
  id             String             @id @default(uuid())
  orderId        String
  order          FranchiseShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  productName    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  sortOrder      Int                @default(0)

  @@index([orderId, sortOrder])
}
